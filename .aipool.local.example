# Copy to .aipool.local and keep that file uncommitted.
# All values below are placeholders; deployment-specific values belong only in
# the ignored file or in the environment.
AIPOOL_PROJECT_ROOT=/path/to/distributed-compute
AIPOOL_MODE=local
AIPOOL_BASE_URL=http://127.0.0.1:8765
AIPOOL_HOST=127.0.0.1
AIPOOL_PORT=8765
AIPOOL_TOKEN=
AIPOOL_DB=.aipool-data/aipool.sqlite
AIPOOL_ARTIFACT_ROOT=.aipool-artifacts
# Optional operator-owned command worker. It receives one JSON task envelope
# on stdin and must write only the worker result to stdout.
# AIPOOL_COMMAND=/path/to/authorized-command-worker
# Optional authorized Discord controller bot. IDs are not secrets; the token
# must never be committed or shared in chat.
# AIPOOL_DISCORD_APPLICATION_ID=
# AIPOOL_DISCORD_GUILD_ID=
# AIPOOL_DISCORD_CHANNEL_ID=
# The exact third-party bot ID selected by the operator after manual invite.
# AIPOOL_DISCORD_TARGET_BOT_ID=
# Optional mention or command prefix, for example "<@1234567890> ".
# AIPOOL_DISCORD_MESSAGE_PREFIX=
# AIPOOL_DISCORD_BOT_TOKEN=
# Optional token-authenticated Hugging Face Inference Providers route. The
# model is operator-selected; HF_TOKEN must be supplied separately as a
# secret environment variable and is never stored in this file.
# AIPOOL_HF_MODEL=openai/gpt-oss-20b
# HF_TOKEN=hf_your_token_here
# AIPOOL_HF_ENDPOINT=https://router.huggingface.co/v1/chat/completions
# Optional no-key browser-chat wrapper. The wrapper must read the rendered
# prompt from stdin and write only the chatbot's text response to stdout.
# AIPOOL_BROWSER_COMMAND=/path/to/authorized-browser-wrapper
